# Copy into Railway -> the relay service -> Variables. Never commit real tokens.

# The bots' tokens from BotFather, separated by commas.
BOT_TOKENS=

# The store bot every relay bot points to, without @.
MAIN_BOT=TroveShopBot

# Your Telegram user id: only these ids may open /admin. Comma separated.
OWNER_IDS=

# Optional
STORE_NAME=DigiVault
# Where the people list is kept; mount a Railway volume here so it outlives deploys.
DATA_DIR=/data
# true: write each bot's description and about text at start.
SET_PROFILE=true
# true: each bot links with its own campaign code, c_<bot username>.
CAMPAIGN=true
# Empty: the banner in relay/assets/banner.jpg. A picture link for another one. off: text only.
WELCOME_PHOTO=
